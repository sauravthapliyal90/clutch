NODE_ENV=production
PORT=5000

DATABASE_URL=your_production_postgres_url

REDIS_URL=your_production_redis_url

JWT_ACCESS_SECRET=your_new_access_secret
JWT_REFRESH_SECRET=your_new_refresh_secret

JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

OTP_TTL_SECONDS=300
OTP_LENGTH=6

AWS_REGION=ap-south-1
S3_BUCKET_NAME=your_bucket
AWS_ACCESS_KEY_ID=your_new_aws_key
AWS_SECRET_ACCESS_KEY=your_new_aws_secret
AWS_UPLOAD_URL_TTL_SECONDS=300

TWILIO_ACCOUNT_SID=your_new_twilio_sid
TWILIO_AUTH_TOKEN=your_new_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_number

RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

CORS_ALLOWED_ORIGINS=https://yourdomain.com